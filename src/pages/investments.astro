---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Investments — Stefan Papp"
  description="An analytical approach to investing: robotaxis, AI, humanoid robots and new energy systems, judged on the facts and the numbers."
  url="/investments"
>
  <!-- Hero Banner -->
  <section class="bg-navy pt-24 pb-20 px-4 md:px-8">
    <div class="max-w-6xl mx-auto">
      <h1 class="text-4xl md:text-6xl font-bold text-white font-sans leading-tight">
        Investments
      </h1>
    </div>
  </section>

  <section class="py-16 md:py-24 px-4 md:px-8 bg-white">
    <div class="max-w-3xl mx-auto">
      <div class="space-y-6 text-slate leading-relaxed text-lg">
        <p>
          I wrote investing for programmers, because I believe that a analytical approach will eventually lead to strong investment results. My goal was to eliminate all behaviour patterns that lead to misjudgements and wrong actions because of emotions and look at the facts.
        </p>
        <p>
          I explore interesting companies in Robotaxis(autonomous driving), AI, humanoid robots and new energy systems. If I find companies that are interesting, I explore all the details and once the data confirms in numbers what I see as a qualitative advantage, I invest.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
