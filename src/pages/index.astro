---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSplit from '../components/HeroSplit.astro';
import SocialProof from '../components/SocialProof.astro';
import FeaturedContent from '../components/FeaturedContent.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Stefan Papp',
  url: 'https://stefanpapp.vercel.app',
  jobTitle: 'Investor & Independent Thinker',
  description: 'Investor and independent thinker bridging idealism and pragmatism.',
  sameAs: [
    'https://www.linkedin.com/in/stefanpapp',
    'https://github.com/stefanpapp',
  ],
};

const socialProofItems = [
  { value: '15+', label: 'Years in Engineering Leadership' },
  { value: '50+', label: 'Engineers Led' },
  { value: '10+', label: 'Companies Advised' },
  { value: '8+',  label: 'Angel Investments' },
];

const featuredCards = [
  {
    title: 'What I Believe',
    description: 'On liberty, the compounding power of ideas, and why independent thinking is the highest-leverage skill in an age of noise.',
    href: '/worldview',
    variant: 'idealistic' as const,
  },
  {
    title: 'Investment Philosophy',
    description: 'Why I back founders who think differently — and the mental models I use to evaluate ideas at the earliest stages.',
    href: '/investments',
    variant: 'professional' as const,
  },
  {
    title: 'About Stefan',
    description: 'Engineering leader turned investor. 15+ years building and leading high-performance teams, now backing the next generation of technical founders.',
    href: '/about-stefan',
    variant: 'idealistic' as const,
  },
];
---

<BaseLayout
  title="Analytical Investor — Worldview, Investments & Independent Thinking"
  description="Investor and independent thinker. A worldview grounded in reason, an investment philosophy built on first-hand engineering experience."
  url="/"
  jsonLd={jsonLd}
>
  <HeroSplit
    leftHeadline="Ideas shape the world."
    leftSubtext="On liberty, growth, and why independent thinking matters more than ever. A worldview grounded in reason, not convention."
    leftCta={{ label: 'Read my thinking', href: '/worldview' }}
    rightHeadline="I invest in what's next."
    rightSubtext="Backing technical founders building developer tools and infrastructure. Small checks, real help, pattern recognition from 15+ years in the trenches."
    rightCta={{ label: 'See my investments', href: '/investments' }}
  />

  <SocialProof items={socialProofItems} />

  <FeaturedContent cards={featuredCards} />

  <!-- CTA Band -->
  <section class="bg-navy py-20 px-8 text-center">
    <h2 class="text-4xl lg:text-5xl font-bold text-white font-sans mb-8">Let's talk.</h2>
    <a
      href="/contact"
      class="inline-block bg-amber text-white font-semibold px-10 py-4 rounded hover:bg-amber-light transition-colors duration-200"
    >
      Get in touch
    </a>
  </section>
</BaseLayout>
